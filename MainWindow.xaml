<Window x:Class="HareketliDuvarKagidi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hareketli Duvar Kâğıdı" Width="940" Height="540"
        MinWidth="760" MinHeight="440" Background="#F4F6F8"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <CheckBox x:Name="StartupCheckBox" DockPanel.Dock="Right" Content="Windows ile başlat"
                      VerticalAlignment="Center" Margin="12,0,0,0" Click="Startup_Click"/>
            <Button DockPanel.Dock="Right" Content="Monitörleri yenile" Padding="16,8" Click="Refresh_Click"/>
            <StackPanel>
                <TextBlock Text="Hareketli Duvar Kâğıdı" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Her ekran için video ve görüntü modu seçin." Foreground="#526071" Margin="0,5,0,0"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="MonitorList" BorderThickness="0" Padding="6" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,10">
                            <TextBlock Text="{Binding Monitor.DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Monitor.Resolution}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding Monitor.Position}" Foreground="#526071"/>
                            <TextBlock Text="{Binding Monitor.DpiDescription}" Foreground="#526071"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="22">
                <StackPanel x:Name="SelectionPanel" DataContext="{Binding SelectedItem, ElementName=MonitorList}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding Monitor.Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Video dosyası" Margin="0,22,0,8"/>
                    <TextBox x:Name="VideoPathBox" Text="{Binding VideoPath, Mode=OneWay}" IsReadOnly="True"
                             Padding="8" TextWrapping="Wrap" MaxHeight="75" VerticalScrollBarVisibility="Auto"/>
                    <Button Content="MP4 / WebM seç…" Click="ChooseVideo_Click" HorizontalAlignment="Left" Padding="14,7" Margin="0,10,0,0"/>
                    <TextBlock Text="Görüntü modu" Margin="0,22,0,8"/>
                    <ComboBox x:Name="ModeBox" SelectedItem="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Padding="8"/>
                    <TextBlock Text="Doldur: kırpar · Sığdır: bant bırakabilir · Uzat: oranı değiştirir"
                               TextWrapping="Wrap" Foreground="#526071" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Başlat" Click="Start_Click" Padding="16,6" Margin="0,0,8,0"/>
                <Button Content="Durdur" Click="Stop_Click" Padding="16,6"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#526071" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>


